# Build instructions for the BigWigsMods packager (https://github.com/BigWigsMods/packager).
# The libraries are not kept in this repository; they are downloaded into Libs/ when a
# release zip is built, each at the current version of its own source (no pinned tags).
package-as: RPSheet

externals:
  Libs/LibStub:
    url: https://repos.wowace.com/wow/libstub/trunk
  Libs/CallbackHandler-1.0:
    url: https://repos.wowace.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  Libs/AceAddon-3.0:
    url: https://repos.wowace.com/wow/ace3/trunk/AceAddon-3.0
  Libs/AceEvent-3.0:
    url: https://repos.wowace.com/wow/ace3/trunk/AceEvent-3.0
  Libs/AceDB-3.0:
    url: https://repos.wowace.com/wow/ace3/trunk/AceDB-3.0
  Libs/AceConsole-3.0:
    url: https://repos.wowace.com/wow/ace3/trunk/AceConsole-3.0
  Libs/AceComm-3.0:
    url: https://repos.wowace.com/wow/ace3/trunk/AceComm-3.0
  Libs/AceDBOptions-3.0:
    url: https://repos.wowace.com/wow/ace3/trunk/AceDBOptions-3.0
  Libs/LibSerialize:
    url: https://github.com/rossnichols/LibSerialize
  Libs/LibDeflate:
    url: https://github.com/SafeteeWoW/LibDeflate
  Libs/LibSharedMedia-3.0:
    url: https://repos.wowace.com/wow/libsharedmedia-3-0/trunk/LibSharedMedia-3.0
  Libs/AceGUI-3.0:
    url: https://repos.wowace.com/wow/ace3/trunk/AceGUI-3.0
  Libs/AceConfig-3.0:
    url: https://repos.wowace.com/wow/ace3/trunk/AceConfig-3.0
  Libs/LibDataBroker-1.1:
    url: https://github.com/tekkub/libdatabroker-1-1
  Libs/LibDBIcon-1.0:
    url: https://repos.wowace.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - .github
  - .gitignore
